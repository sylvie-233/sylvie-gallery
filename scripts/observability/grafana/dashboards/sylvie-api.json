      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "sylvie-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(sylvie_http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ],
      "title": "各路由 P95 延迟",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "sylvie-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 11 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "sylvie-prometheus" },
          "expr": "sum by (mcp_tool_name, mcp_tool_outcome) (rate(sylvie_mcp_tool_calls_total[5m]))",
          "legendFormat": "{{mcp_tool_name}} / {{mcp_tool_outcome}}",
          "refId": "A"
        }
      ],
      "title": "MCP 工具调用速率",
