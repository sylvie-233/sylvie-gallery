# 复制为 scripts/.env 后按需修改；docker compose 会自动读取同目录 .env。
#
# 生产部署前必须修改：
#   - MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD
#   - S3_ACCESS_KEY / S3_SECRET_KEY
# 并做好数据卷备份（MySQL 与 RustFS 缺一不可，两者共同构成完整图库）。

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=sylvie_gallery
MYSQL_USER=sylvie
MYSQL_PASSWORD=123456
MYSQL_PORT=3306

# ---------- RustFS（S3 兼容对象存储） ----------
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_PORT=9000
# 管理控制台端口
S3_CONSOLE_PORT=9001
