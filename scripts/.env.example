# 复制为 scripts/.env 后按需修改；docker compose 会自动读取同目录 .env。
#
# 生产部署前必须修改：
#   - MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD
#   - JWT_SECRET（至少 32 位随机字符串）
#   - S3_ACCESS_KEY / S3_SECRET_KEY
# 并做好数据卷备份（MySQL 与 RustFS 缺一不可，两者共同构成完整图库；Redis 仅存缓存与限流计数，可随时清空）。

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=123456
# 数据库名需与 docs/美女写真网站-v1数据库设计.sql 中的库名一致
MYSQL_DATABASE=sylvie_gallery
MYSQL_USER=sylvie
MYSQL_PASSWORD=123456
MYSQL_PORT=3306
DB_CONNECTION_LIMIT=10

# ---------- Redis ----------
# 宿主端口；容器内 API 固定连接 redis:6379
REDIS_PORT=6379
CACHE_PREFIX=sylvie
RATE_LIMIT_ENABLED=true
JOB_ENABLED=true
JOB_CONCURRENCY=2
JOB_VIP_SWEEP_CRON=*/10 * * * *

# ---------- Mailpit（开发邮件捕获） ----------
# 网页端 http://localhost:8025，SMTP 端口 1025
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MAILPIT_MAX_MESSAGES=1000
# API 发信参数（容器内默认连接 mailpit:1025）
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=希尔薇图集 <noreply@sylvie.cc>

# ---------- API ----------
API_PORT=3000
JWT_SECRET=sylvie-dev-secret-change-me-please
# 7 天（秒）
JWT_EXPIRES_IN=604800
# 允许跨域的来源（多个用英文逗号分隔）
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:8080,http://localhost:8081
# 开发/演示验证码；生产接入 SMTP 后留空
VERIFY_CODE_DEMO=123456
# 本地模拟支付宝支付；接入真实支付宝后设为 false
ALIPAY_MOCK=true

# ---------- RustFS（S3 兼容对象存储） ----------
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_BUCKET=sylvie
S3_PORT=9000
# 管理控制台端口
S3_CONSOLE_PORT=9001

# ---------- Web / Admin ----------
# 前台 Web 宿主机端口（容器内 Next 监听 3001）
WEB_PORT=8080
# 管理后台宿主机端口（容器内 Nginx 监听 80）
ADMIN_PORT=8081
# 后台“返回前台首页”与评论里的图集链接使用的公网地址（构建时内联）
WEB_PUBLIC_URL=http://localhost:8080
