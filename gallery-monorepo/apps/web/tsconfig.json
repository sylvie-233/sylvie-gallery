{
  "extends": "@sylvie/tsconfig/next.json",
  "compilerOptions": {
    // baseUrl 已在 TS 7 nightly 中移除；未设置时 paths 相对本 tsconfig 解析
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
