# 复制为同目录下的 .env 后按需修改
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MySQL（与 scripts/docker-compose.yml 默认值一致）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sylvie
DB_PASSWORD=123456
DB_NAME=sylvie_gallery
DB_CONNECTION_LIMIT=10

# JWT：生产环境必须替换为随机长字符串（至少 16 位，建议 32 位以上）
JWT_SECRET=sylvie-dev-secret-change-me-please
JWT_EXPIRES_IN=604800

# 允许跨域的来源（多个用英文逗号分隔）
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# 日志：level 为 trace/debug/info/warn/error/fatal/silent；pretty 留空则开发环境彩色、生产环境 JSON
LOG_LEVEL=info
LOG_PRETTY=

# MCP（Streamable HTTP）：端点 /api/mcp，使用管理员 JWT 接入
# MCP_ALLOW_WRITE=true 时才会注册管理写操作工具；生产环境请谨慎开启
MCP_ENABLED=true
MCP_ALLOW_WRITE=true

# 缓存与限流：本地默认内存；生产建议 redis（compose 已内置 redis:7.4）
CACHE_DRIVER=memory
CACHE_PREFIX=sylvie
CACHE_DEFAULT_TTL=60
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_ENABLED=true

# 任务调度（BullMQ，需要 Redis）：会员到期降级与到期通知
# 本地未启动 Redis 时保持 false；docker compose 会自动设为 true
JOB_ENABLED=false
JOB_CONCURRENCY=2
JOB_VIP_SWEEP_CRON=*/10 * * * *

# 消息队列（RabbitMQ）：真实支付通知通过 MQ 异步履约
MQ_ENABLED=false
MQ_URL=amqp://sylvie:123456@127.0.0.1:5672
MQ_QUEUE_PREFIX=sylvie
MQ_PREFETCH=1

# 支付宝：开发阶段使用沙箱
# 1) ALIPAY_MOCK=true 时不走真实支付；2) 密钥 PEM 的换行可用 \n 表示
ALIPAY_MOCK=true
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost:3000/api/orders/alipay/notify
ALIPAY_RETURN_URL=http://localhost:3001/membership
ALIPAY_SIGN_TYPE=RSA2
# 兼容字段；私钥格式（PKCS1 / PKCS8）由服务端自动识别
ALIPAY_KEY_TYPE=PKCS8

# 邮件：本地对接 docker compose 中的 Mailpit（SMTP 1025 / 网页端 8025）
# SMTP_HOST 留空则跳过发信（验证码仍会打印到日志）
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=希尔薇图集 <noreply@sylvie.cc>

# RustFS（S3 兼容对象存储）
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=sylvie
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# 邮箱验证码：开发环境固定使用该验证码；生产环境留空则随机生成并写日志
VERIFY_CODE_DEMO=123456

# 支付宝：v1 未接入真实支付时使用本地模拟支付（创建订单后可直接确认支付）
ALIPAY_MOCK=true
